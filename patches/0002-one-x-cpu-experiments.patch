+// Copyright (c) 2026 xllama contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "ggml-backend.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Set/reset/read only while the CPU graph is idle. One process-wide session.
+enum ggml_xllama_cpu_flag {
+    GGML_XLLAMA_PROFILE = 1,
+    GGML_XLLAMA_GUIDED = 2,
+    GGML_XLLAMA_ROW_OPS = 4,
+};
+struct ggml_xllama_op_stat {
+    uint64_t calls;
+    uint64_t wall_us;
+    uint64_t head_wall_us;
+};
+GGML_BACKEND_API void ggml_cpu_xllama_set_flags(unsigned flags);
+GGML_BACKEND_API unsigned ggml_cpu_xllama_flags(void);
+GGML_BACKEND_API void ggml_cpu_xllama_reset_stats(void);
+GGML_BACKEND_API struct ggml_xllama_op_stat ggml_cpu_xllama_op_stat(int op);
+GGML_BACKEND_API uint64_t ggml_cpu_xllama_guided_calls(void);
+GGML_BACKEND_API uint64_t ggml_cpu_xllama_row_calls(void);
+GGML_BACKEND_API void ggml_cpu_xllama_note_row(void);
+#ifdef __cplusplus
+}
+#endif
