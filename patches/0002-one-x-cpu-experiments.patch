+// Opt-in smolmaxxing-style experiments. Worker zero is the sole stats writer.
+static unsigned xllama_cpu_flags;
+static struct ggml_xllama_op_stat xllama_cpu_stats[GGML_OP_COUNT];
+static uint64_t xllama_guided_calls;
+static uint64_t xllama_row_calls;
+void ggml_cpu_xllama_set_flags(unsigned flags) { xllama_cpu_flags = flags & 7u; }
+unsigned ggml_cpu_xllama_flags(void) { return xllama_cpu_flags; }
+void ggml_cpu_xllama_reset_stats(void) {
+    memset(xllama_cpu_stats, 0, sizeof(xllama_cpu_stats));
+    xllama_guided_calls = xllama_row_calls = 0;
+}
+struct ggml_xllama_op_stat ggml_cpu_xllama_op_stat(int op) {
+    struct ggml_xllama_op_stat empty = {0, 0, 0};
+    return op >= 0 && op < GGML_OP_COUNT ? xllama_cpu_stats[op] : empty;
+}
+uint64_t ggml_cpu_xllama_guided_calls(void) { return xllama_guided_calls; }
+uint64_t ggml_cpu_xllama_row_calls(void) { return xllama_row_calls; }
+void ggml_cpu_xllama_note_row(void) { ++xllama_row_calls; }
+
+static bool xllama_claim_rows(struct ggml_threadpool * tp, int limit, int nth,
+                             int * begin, int * end) {
+    int start = atomic_load_explicit(&tp->current_chunk, memory_order_relaxed);
+    while (start < limit) {
+        // Shrink the tail, keeping 16-row alignment for SIMD kernels.
+        int count = MAX(16, ((limit - start) / (2 * nth) + 15) / 16 * 16);
+        int stop = MIN(start + count, limit);
+#ifdef _MSC_VER
+        int observed = (int) InterlockedCompareExchange(&tp->current_chunk, stop, start);
+        bool claimed = observed == start;
+        if (!claimed) { start = observed; }
+#else
+        bool claimed = atomic_compare_exchange_weak_explicit(&tp->current_chunk, &start, stop,
+                                                             memory_order_relaxed, memory_order_relaxed);
+#endif
+        if (claimed) { *begin = start; *end = stop; return true; }
+    }
+    return false;
+}
