# Exact upstream licence bytes — catalogue sha256 pins these files;
# MSIX runtime notices must stay byte-identical too.
LICENSES/*-LICENSE -text
LICENSES/*-LICENSE.txt -text
LICENSES/*-NOTICE -text
LICENSES/*-ThirdPartyNotices.txt -text

# Preserve unified patch syntax and LF context on Windows checkouts.
patches/*.patch text eol=lf whitespace=-blank-at-eol
